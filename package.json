{
  "name": "fixture-lens",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build-public.mjs",
    "refresh:predictions": "node scripts/refresh-predictions.mjs",
    "test": "node --test && python -m unittest discover -s test -p \"test_*.py\"",
    "validate": "node scripts/validate-data.mjs && node scripts/validate-predictions.mjs --name-map-input data/fpl-player-display-names.json && node scripts/validate-public.mjs",
    "validate:fixtures": "node scripts/validate-data.mjs",
    "validate:predictions": "node scripts/validate-predictions.mjs --name-map-input data/fpl-player-display-names.json"
  }
}
